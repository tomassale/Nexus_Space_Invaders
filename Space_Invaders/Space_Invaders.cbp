<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Space_Invaders" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Space_Invaders" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="sdl_image/include/SDL2" />
					<Add directory="sdl_mixer/include/SDL2" />
					<Add directory="sdl_ttf/include/SDL2" />
				</Compiler>
				<Linker>
					<Add library="mingw32" />
					<Add library="SDL2main" />
					<Add library="SDL2" />
					<Add library="SDL2_image" />
					<Add library="SDL2_ttf" />
					<Add library="SDL2_mixer" />
					<Add directory="sdl_image/lib" />
					<Add directory="sdl_mixer/lib" />
					<Add directory="sdl_ttf/lib" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Space_Invaders" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="sdl_image/include/SDL2" />
					<Add directory="sdl_mixer/include/SDL2" />
					<Add directory="sdl_ttf/include/SDL2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="mingw32" />
					<Add library="SDL2main" />
					<Add library="SDL2" />
					<Add library="SDL2_image" />
					<Add library="SDL2_ttf" />
					<Add library="SDL2_mixer" />
					<Add directory="sdl_image/lib" />
					<Add directory="sdl_mixer/lib" />
					<Add directory="sdl_ttf/lib" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="../SDL_dev_lib/include/SDL2" />
		</Compiler>
		<Linker>
			<Add option="-lmingw32 -lSDL2main -lSDL2" />
			<Add directory="../SDL_dev_lib/lib" />
		</Linker>
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="main.h" />
		<Unit filename="src/audio.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/audio.h" />
