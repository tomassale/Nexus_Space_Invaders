		<Unit filename="src/fonts.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/fonts.h" />
		<Unit filename="src/game.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/game.h" />
